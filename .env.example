# Admin login (seeded on first boot if the account does not already exist)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=
ADMIN_AUTH_REQUIRED=true
ADMIN_AUTH_PROVIDER=local
# Temporary only. Set true when the whole site must be public during testing.
PUBLIC_TESTING_MODE=false
# ADMIN_AUTH_PROVIDER=supabase
SUPABASE_ADMIN_EMAILS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local development defaults. Production should use Supabase providers.
RAMS_STORAGE_PROVIDER=local
# RAMS_STORAGE_PROVIDER=supabase
RAMS_DATABASE_PROVIDER=sqlite
# RAMS_DATABASE_PROVIDER=supabase
SUPABASE_RAMS_BUCKET=rams-documents
SUBMISSIONS_STORAGE_PROVIDER=local
# SUBMISSIONS_STORAGE_PROVIDER=supabase
SUBMISSIONS_DATABASE_PROVIDER=sqlite
# SUBMISSIONS_DATABASE_PROVIDER=supabase
SUPABASE_UPLOADS_BUCKET=uplands-uploads
PERMITS_DATABASE_PROVIDER=sqlite
# PERMITS_DATABASE_PROVIDER=supabase
ACTIVITY_DATABASE_PROVIDER=sqlite
# ACTIVITY_DATABASE_PROVIDER=supabase

# Local development may process inline. Production defaults to manual unless a worker webhook is configured.
RAMS_PROCESSING_MODE=inline
# RAMS_PROCESSING_MODE=manual
# RAMS_PROCESSING_MODE=webhook
# RAMS_PROCESSING_WEBHOOK_URL=https://worker.example.com/process-rams
# RAMS_PROCESSING_SECRET=

# Upstash Redis-backed rate limiting. Keep the REST token server-side only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_RATE_LIMIT_ANALYTICS=false

# RAMS Document Intelligence
EMBEDDING_PROVIDER=local
AI_PROVIDER=disabled
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# OCR for scanned/image-only RAMS PDFs. Requires Poppler pdftoppm in the runtime.
OCR_PROVIDER=disabled
# OCR_PROVIDER=tesseract
OCR_MAX_PAGES=80

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=uplands
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAYS_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.25
